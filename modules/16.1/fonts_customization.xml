<?xml version="1.0" encoding="utf-8"?>
<fonts-modification version="1">
  <!-- Preserve the names used by the UI and map their base weights to system Roboto. -->
  <!-- UI aliases reuse /system/fonts/Roboto-Regular.ttf through system families. -->

  <!-- Display -->
  <alias name="variable-display-large" to="sans-serif" weight="400"/>
  <alias name="variable-display-large-emphasized" to="sans-serif" weight="500"/>
  <alias name="variable-display-medium" to="sans-serif" weight="400"/>
  <alias name="variable-display-medium-emphasized" to="sans-serif" weight="500"/>
  <alias name="variable-display-small" to="sans-serif" weight="400"/>
  <alias name="variable-display-small-emphasized" to="sans-serif" weight="500"/>

  <!-- Headline -->
  <alias name="variable-headline-large" to="sans-serif" weight="400"/>
  <alias name="variable-headline-large-emphasized" to="sans-serif" weight="500"/>
  <alias name="variable-headline-medium" to="sans-serif" weight="400"/>
  <alias name="variable-headline-medium-emphasized" to="sans-serif" weight="500"/>
  <alias name="variable-headline-small" to="sans-serif" weight="400"/>
  <alias name="variable-headline-small-emphasized" to="sans-serif" weight="500"/>

  <!-- Title -->
  <alias name="variable-title-large" to="sans-serif" weight="400"/>
  <alias name="variable-title-large-emphasized" to="sans-serif" weight="500"/>
  <alias name="variable-title-medium" to="sans-serif" weight="500"/>
  <alias name="variable-title-medium-emphasized" to="sans-serif" weight="600"/>
  <alias name="variable-title-small" to="sans-serif" weight="500"/>
  <alias name="variable-title-small-emphasized" to="sans-serif" weight="600"/>

  <!-- Label -->
  <alias name="variable-label-large" to="sans-serif" weight="500"/>
  <alias name="variable-label-large-emphasized" to="sans-serif" weight="600"/>
  <alias name="variable-label-medium" to="sans-serif" weight="500"/>
  <alias name="variable-label-medium-emphasized" to="sans-serif" weight="600"/>
  <alias name="variable-label-small" to="sans-serif" weight="500"/>
  <alias name="variable-label-small-emphasized" to="sans-serif" weight="600"/>

  <!-- Body -->
  <alias name="variable-body-large" to="sans-serif" weight="400"/>
  <alias name="variable-body-large-emphasized" to="sans-serif" weight="500"/>
  <alias name="variable-body-medium" to="sans-serif" weight="400"/>
  <alias name="variable-body-medium-emphasized" to="sans-serif" weight="500"/>
  <alias name="variable-body-small" to="sans-serif" weight="400"/>
  <alias name="variable-body-small-emphasized" to="sans-serif" weight="500"/>

  <!-- Use the existing condensed Roboto family for the narrow notification metric. -->
  <alias name="variable-display-small-emphasized-narrow" to="sans-serif-condensed" weight="500"/>

  <!-- Compatibility names used by Settings and SystemUI. -->
  <alias name="google-sans" to="sans-serif" weight="400"/>
  <alias name="google-sans-regular" to="sans-serif" weight="400"/>
  <alias name="google-sans-medium" to="sans-serif" weight="500"/>
  <alias name="google-sans-bold" to="sans-serif" weight="700"/>
  <alias name="google-sans-flex" to="sans-serif" weight="400"/>
  <!-- Font overlays can request these names directly for QS labels and other UI text. -->
  <alias name="google-sans-flex-medium" to="sans-serif" weight="500"/>
  <alias name="google-sans-flex-bold" to="sans-serif" weight="700"/>
  <alias name="google-sans-text" to="sans-serif" weight="400"/>
  <alias name="google-sans-text-regular" to="sans-serif" weight="400"/>
  <alias name="google-sans-text-medium" to="sans-serif" weight="500"/>
  <alias name="google-sans-text-bold" to="sans-serif" weight="700"/>
  <!-- The system family fixes ital=1; aliases select the requested weight. -->
  <alias name="google-sans-text-italic" to="roboto-italic" weight="400"/>
  <alias name="google-sans-text-medium-italic" to="roboto-italic" weight="500"/>
  <alias name="google-sans-text-bold-italic" to="roboto-italic" weight="700"/>

  <!-- The non-Pixel variant uses Roboto for lockscreen/AOD clocks too. -->
  <alias name="google-sans-clock" to="sans-serif" weight="400"/>
  <alias name="google-sans-flex-clock" to="sans-serif" weight="400"/>
</fonts-modification>
